{
  "name": "opencode-wrappers",
  "private": true,
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh && bun run src/cli/init-web-database.ts",
    "check": "bun run typecheck",
    "lint": "bun run lint:deprecated && oxlint src test e2e playwright.config.ts",
    "lint:ci": "bun run lint:deprecated && oxlint src test e2e playwright.config.ts --format github",
    "lint:deprecated": "oxlint src test e2e playwright.config.ts --config .oxlintrc.deprecated.json --disable-nested-config --type-aware --allow all --deny typescript/no-deprecated",
    "test": "bun run test:bot",
    "typecheck": "tsgo --noEmit",
    "telegram": "bun run src/telegram/main.ts",
    "password": "bun run src/cli/generate-password.ts",
    "jwt-secret": "bun run src/cli/generate-jwt-secret.ts",
    "init:web-database": "bun run src/cli/init-web-database.ts",
    "dev": "bun run --watch src/telegram/main.ts",
    "web:codegen": "panda codegen && panda cssgen",
    "web:dev": "bun run web:codegen && vite --config vite.web.config.ts",
    "web:server": "bun run src/web/backend/server.ts",
    "web:build:start": "bun run web:build && bun run web:server",
    "prepare:park-ui": "./scripts/prepare-park-ui.sh",
    "web:build": "bun run web:codegen && vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts",
    "test:bot": "bun test test/",
    "test:e2e": "playwright test",
    "opencode": "opencode2 serve --service",
    "opencode:status": "opencode2 service status",
    "opencode:restart": "opencode2 service restart"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.38.0",
    "@effect/platform-bun": "4.0.0-beta.107",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@opencode-ai/client": "0.0.0-beta-18600",
    "@resvg/resvg-js": "2.6.2",
    "@tanstack/solid-virtual": "^3.13.36",
    "@vercel/beautiful-mermaid": "0.1.5",
    "effect": "4.0.0-beta.107",
    "geist": "1.7.2",
    "lucide-solid": "^1.30.0",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@pandacss/dev": "^1.12.0",
    "@park-ui/cli": "^1.0.1",
    "@park-ui/panda-preset": "^0.43.1",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14"
  }
}
