# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional outbound-only delivery bots. Use stable lowercase ids.
# Example: [{"id":"delivery-1","token":"123456:replace-me"}]
TELEGRAM_BOT_POOL=

# OpenCode connection.
# When OPENCODE_BASE_URL is empty, the bot discovers the local opencode2
# service (registration file ~/.local/state/opencode/service.json) and
# uses its Basic auth automatically.
OPENCODE_BASE_URL=
OPENCODE_USERNAME=
OPENCODE_PASSWORD=

# Directory that OpenCode sessions run in.
PROJECT_DIRECTORY=

# Where the bot stores chat -> session state.
STATE_FILE=./data/state.json

# Comma-separated Telegram user ids allowed to use the bot. Empty = deny all.
TELEGRAM_ALLOWED_USERS=

# Maximum time for one OpenCode run. Use "none" to disable the limit.
TELEGRAM_RUN_TIMEOUT=10 minutes
