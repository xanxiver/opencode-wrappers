# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional outbound-only delivery bots. Use stable lowercase ids.
# Example: [{"id":"delivery-1","token":"123456:replace-me"}]
TELEGRAM_BOT_POOL=

# OpenCode connection.
# When OPENCODE_BASE_URL is empty, the bot discovers the local opencode2
# service (registration file ~/.local/state/opencode/service.json) and
# uses its Basic auth automatically.
OPENCODE_BASE_URL=
OPENCODE_USERNAME=
OPENCODE_PASSWORD=

# Directory that OpenCode sessions run in.
PROJECT_DIRECTORY=

# Where the bot stores chat -> session state.
STATE_FILE=./data/state.json

# Comma-separated Telegram user ids allowed to use the bot. Empty = deny all.
TELEGRAM_ALLOWED_USERS=

# Maximum time for one OpenCode run. Use "none" to disable the limit.
TELEGRAM_RUN_TIMEOUT=10 minutes

# Enable metadata-only diagnostics for Telegram message streaming.
TELEGRAM_STREAM_DEBUG=false

# Web API server port.
WEB_PORT=3001
WEB_HOST=127.0.0.1
WEB_SECURE_COOKIES=false
# SQLite file for web user preferences, including projects and sessions.
WEB_DATABASE_FILE=./data/web.sqlite
# OpenCode SQLite file used for observability usage data.
# Common local path: ~/.local/share/opencode/opencode.db
OPENCODE_DATABASE_FILE=

# Web login. Generate a password hash with: bun -e 'console.log(await Bun.password.hash(process.argv[1]))' 'your-password'
WEB_USERNAME=
WEB_PASSWORD_HASH=
# Use a random secret of at least 32 bytes. Never commit it.
WEB_JWT_SECRET=
# Optional exact origins for cookie-authenticated development requests,
# for example: http://localhost:3000,http://127.0.0.1:3000
WEB_TRUSTED_ORIGINS=
# Comma-separated workspace roots. The picker lists each root and its direct child folders.
WEB_WORKSPACE_ROOTS=/home/azure/Projects

# Vite development UI port.
WEB_UI_PORT=3000
